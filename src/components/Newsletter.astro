---
// Newsletter.astro - Componente de suscripción al newsletter
export interface Props {
  title?: string;
  description?: string;
  placeholder?: string;
  buttonText?: string;
  compact?: boolean;
}

const {
  title = "Mantente al día",
  description = "Recibe las últimas noticias sobre drones, tecnología y tendencias directamente en tu bandeja de entrada.",
  placeholder = "tu@email.com",
  buttonText = "Suscribirse",
  compact = false
} = Astro.props;
---

<div class={`newsletter-container ${compact ? 'newsletter-compact' : 'newsletter-full'}`}>
  <div class="newsletter-content">
    {!compact && (
      <div class="newsletter-header">
        <div class="newsletter-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <h3 class="newsletter-title">{title}</h3>
        <p class="newsletter-description">{description}</p>
      </div>
    )}
    
    <form class="newsletter-form" id="newsletter-form" novalidate>
      <div class="form-group">
        <label for="email" class="sr-only">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder={placeholder}
          required
          class="email-input"
          autocomplete="email"
        />
        <button type="submit" class="submit-button" disabled>
          <span class="button-text">{buttonText}</span>
          <span class="button-loading" style="display: none;">
            <svg class="loading-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
            </svg>
          </span>
          <span class="button-success" style="display: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20,6 9,17 4,12"></polyline>
            </svg>
          </span>
        </button>
      </div>
      
      <div class="form-feedback">
        <div class="success-message" id="success-message" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20,6 9,17 4,12"></polyline>
          </svg>
          <span>¡Gracias por suscribirte! Revisa tu email para confirmar.</span>
        </div>
        <div class="error-message" id="error-message" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
          <span id="error-text">Hubo un error. Por favor, intenta de nuevo.</span>
        </div>
      </div>
    </form>
    
    {!compact && (
      <div class="newsletter-footer">
        <p class="privacy-text">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <circle cx="12" cy="16" r="1"></circle>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          No spam. Puedes darte de baja en cualquier momento.
        </p>
      </div>
    )}
  </div>
</div>

<style>
  .newsletter-container {
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .newsletter-container:hover {
    border-color: var(--accent-color);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .newsletter-full {
    padding: 2rem;
    text-align: center;
  }

  .newsletter-compact {
    padding: 1.5rem;
  }

  .newsletter-header {
    margin-bottom: 2rem;
  }

  .newsletter-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--accent-color-alpha);
    color: var(--accent-color);
    border-radius: 12px;
    margin-bottom: 1rem;
  }

  .newsletter-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .newsletter-description {
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 400px;
    margin: 0 auto;
  }

  .newsletter-form {
    margin-bottom: 1rem;
  }

  .form-group {
    display: flex;
    gap: 0.5rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .newsletter-compact .form-group {
    max-width: none;
  }

  .email-input {
    flex: 1;
    padding: 0.875rem 1rem;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .email-input:focus {
    outline: none;
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px var(--accent-color-alpha);
  }

  .email-input:invalid {
    border-color: #ef4444;
  }

  .submit-button {
    padding: 0.875rem 1.5rem;
    background: var(--accent-color);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 120px;
  }

  .submit-button:hover:not(:disabled) {
    background: var(--accent-color-hover);
    transform: translateY(-1px);
  }

  .submit-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .loading-spinner {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .form-feedback {
    margin-top: 1rem;
  }

  .success-message,
  .error-message {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .success-message {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .error-message {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
  }

  .newsletter-footer {
    margin-top: 1.5rem;
  }

  .privacy-text {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.8;
  }

  /* Dark mode adjustments */
  :global(.dark) .success-message {
    background: #064e3b;
    color: #6ee7b7;
    border-color: #047857;
  }

  :global(.dark) .error-message {
    background: #7f1d1d;
    color: #fca5a5;
    border-color: #dc2626;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .newsletter-full {
      padding: 1.5rem;
    }

    .form-group {
      flex-direction: column;
    }

    .submit-button {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('newsletter-form');
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const submitButton = form?.querySelector('.submit-button') as HTMLButtonElement;
    const buttonText = submitButton?.querySelector('.button-text');
    const buttonLoading = submitButton?.querySelector('.button-loading');
    const buttonSuccess = submitButton?.querySelector('.button-success');
    const successMessage = document.getElementById('success-message');
    const errorMessage = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');

    // Enable/disable submit button based on email validity
    emailInput?.addEventListener('input', () => {
      const isValid = emailInput.validity.valid && emailInput.value.length > 0;
      if (submitButton) {
        submitButton.disabled = !isValid;
      }
    });

    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!emailInput?.validity.valid) return;

      const email = emailInput.value;
      
      // Show loading state
      if (submitButton) {
        submitButton.disabled = true;
        buttonText && (buttonText.style.display = 'none');
        buttonLoading && (buttonLoading.style.display = 'inline-flex');
      }

      // Hide previous messages
      successMessage && (successMessage.style.display = 'none');
      errorMessage && (errorMessage.style.display = 'none');

      try {
        // Simulate API call (replace with actual newsletter service)
        await new Promise(resolve => setTimeout(resolve, 1500));
        
        // For demo purposes, we'll just show success
        // In production, integrate with services like Mailchimp, ConvertKit, etc.
        
        // Show success state
        if (buttonLoading) buttonLoading.style.display = 'none';
        if (buttonSuccess) buttonSuccess.style.display = 'inline-flex';
        if (successMessage) successMessage.style.display = 'flex';
        
        // Reset form
        emailInput.value = '';
        
        // Reset button after delay
        setTimeout(() => {
          if (buttonSuccess) buttonSuccess.style.display = 'none';
          if (buttonText) buttonText.style.display = 'inline';
          if (submitButton) submitButton.disabled = true;
        }, 3000);

        // Track newsletter signup (analytics)
        if (typeof gtag !== 'undefined') {
          gtag('event', 'newsletter_signup', {
            event_category: 'engagement',
            event_label: 'footer_newsletter'
          });
        }

      } catch (error) {
        console.error('Newsletter signup error:', error);
        
        // Show error state
        if (buttonLoading) buttonLoading.style.display = 'none';
        if (buttonText) buttonText.style.display = 'inline';
        if (errorMessage) errorMessage.style.display = 'flex';
        if (errorText) errorText.textContent = 'Error al suscribirse. Intenta de nuevo.';
        if (submitButton) submitButton.disabled = false;
      }
    });
  });
</script>