---
// Critical CSS component for above-the-fold content
---

<style is:inline>
  /* Critical CSS for immediate rendering - Optimized for LCP */
  
  /* Minimal reset for faster parsing */
  *,*::before,*::after{box-sizing:border-box}
  html{line-height:1.15;-webkit-text-size-adjust:100%}
  body{
    margin:0;
    font-family:system-ui,-apple-system,sans-serif;
    font-display:swap;
    background:#fff;
    color:#18181b;
    contain:layout style paint;
  }
  
  /* Dark mode - Optimized */
  @media(prefers-color-scheme:dark){
    body{background:#09090b;color:#fafafa}
  }
  
  /* Navigation - Minimal critical styles */
  nav{position:sticky;top:0;z-index:50;backdrop-filter:blur(8px);background:rgba(255,255,255,.8)}
  @media(prefers-color-scheme:dark){nav{background:rgba(9,9,11,.8)}}
  
  /* Hero section - Essential only */
  .hero-section{min-height:60vh;display:flex;align-items:center;justify-content:center}
  
  /* Image optimization - Critical for LCP */
  img{height:auto;max-width:100%;display:block;content-visibility:auto}
  
  /* Loading states - Minimal */
  .loading{opacity:0;transition:opacity .3s}
  .loaded{opacity:1}
  
  /* Typography - Essential only */
  h1,h2,h3,h4,h5,h6{margin:0;font-weight:600;line-height:1.2}
  p{margin:0;line-height:1.6}
  
  /* Responsive - Mobile first */
  @media(max-width:640px){
    .hero-section{min-height:50vh}
  }
</style>