---
// Browser compatibility component for enhanced cross-browser support
---

<script>
  // Optimized polyfill loading for better performance
  (function() {
    // Only load polyfills if needed and use modern loading techniques
    const loadPolyfill = (condition, src, callback) => {
      if (condition) {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.defer = true;
        if (callback) script.onload = callback;
        document.head.appendChild(script);
      }
    };

    // IntersectionObserver polyfill for lazy loading (only if needed)
    if (!('IntersectionObserver' in window)) {
      loadPolyfill(true, 'https://polyfill.io/v3/polyfill.min.js?features=IntersectionObserver');
    }

    // CSS custom properties polyfill for IE11 (only if needed)
    if (!CSS.supports('color', 'var(--fake-var)')) {
      loadPolyfill(true, 'https://cdn.jsdelivr.net/npm/css-vars-ponyfill@2', function() {
        if (window.cssVars) {
          cssVars({
            include: 'style,link[rel="stylesheet"]',
            preserveStatic: false,
            watch: false // Disable watching for better performance
          });
        }
      });
    }

    // Object-fit polyfill for IE (only if needed)
    if (!('objectFit' in document.documentElement.style)) {
      loadPolyfill(true, 'https://cdn.jsdelivr.net/npm/object-fit-images@3.2.4/dist/ofi.min.js', function() {
        if (window.objectFitImages) {
          objectFitImages();
        }
      });
    }

    // Fetch polyfill for older browsers (only if needed)
    if (!window.fetch) {
      loadPolyfill(true, 'https://cdn.jsdelivr.net/npm/whatwg-fetch@3.6.2/dist/fetch.umd.js');
    }

    // Optimize viewport height calculation
    const setVH = () => {
      const vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty('--vh', `${vh}px`);
    };

    // Set initial value
    setVH();

    // Update on resize with throttling
    let resizeTimer;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(setVH, 100);
    });

    // Optimize font loading
    if ('fonts' in document) {
      document.fonts.ready.then(() => {
        document.body.classList.add('fonts-loaded');
      });
    }
  })();
</script>

<style>
  /* Optimized CSS for better performance */
  
  /* Prevent layout shift during font loading */
  body:not(.fonts-loaded) {
    font-display: swap;
  }

  /* Smooth scrolling with reduced motion support */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* Optimized focus styles */
  :focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  /* Remove outline for mouse users */
  :focus:not(:focus-visible) {
    outline: none;
  }

  /* Optimized selection styles */
  ::selection {
    background-color: #3b82f6;
    color: white;
  }

  /* Dark mode selection */
  :root.dark ::selection {
    background-color: #60a5fa;
    color: #1f2937;
  }

  /* Optimized image loading */
  img {
    height: auto;
    max-width: 100%;
  }

  /* Prevent layout shift for images */
  img[width][height] {
    height: auto;
  }

  /* Optimized button styles */
  button, [role="button"] {
    cursor: pointer;
    touch-action: manipulation;
  }

  /* Optimized input styles */
  input, textarea, select {
    font-family: inherit;
    font-size: inherit;
  }

  /* Reduce motion for users who prefer it */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Optimized print styles */
  @media print {
    * {
      background: transparent !important;
      color: black !important;
      box-shadow: none !important;
      text-shadow: none !important;
    }
    
    a, a:visited {
      text-decoration: underline;
    }
    
    img {
      max-width: 100% !important;
    }
    
    @page {
      margin: 0.5cm;
    }
  }

  /* CSS custom properties for viewport height with fallback */
  .min-h-screen {
    min-height: 100vh;
    min-height: calc(var(--vh, 1vh) * 100);
  }

  /* Optimized loading states */
  .loading {
    opacity: 0.7;
    pointer-events: none;
  }

  /* Hardware acceleration for smooth animations */
  .will-change-transform {
    will-change: transform;
  }

  .will-change-opacity {
    will-change: opacity;
  }
</style>