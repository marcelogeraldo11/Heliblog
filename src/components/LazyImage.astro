---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  style?: string;
}

const { 
  src, 
  alt, 
  width = 400, 
  height = 225, 
  loading = 'lazy', 
  fetchpriority = 'auto',
  class: className = '',
  style = '',
  ...rest 
} = Astro.props;

// Optimized style with content-visibility
const optimizedStyle = `content-visibility: auto; contain-intrinsic-size: ${width}px ${height}px; ${style}`;
---

<img 
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={className}
  style={optimizedStyle}
  {...rest}
/>