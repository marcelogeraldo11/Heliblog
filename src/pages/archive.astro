---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';

// Get all blog posts
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Group posts by year and month
const postsByDate = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  const month = post.data.pubDate.getMonth();
  const monthNames = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
  ];
  
  if (!acc[year]) {
    acc[year] = {};
  }
  
  if (!acc[year][month]) {
    acc[year][month] = {
      name: monthNames[month],
      posts: []
    };
  }
  
  acc[year][month].posts.push(post);
  return acc;
}, {} as Record<number, Record<number, { name: string; posts: any[] }>>);

// Get years in descending order
const years = Object.keys(postsByDate).map(Number).sort((a, b) => b - a);

// Calculate statistics
const totalPosts = posts.length;
const currentYear = new Date().getFullYear();
const postsThisYear = posts.filter(post => post.data.pubDate.getFullYear() === currentYear).length;
---

<Layout 
  title="Archivo de Posts - Heliboss Blog" 
  description="Explora todos nuestros artículos organizados por fecha. Encuentra contenido sobre drones, tecnología y tendencias del sector."
>
  <div class="max-w-4xl mx-auto">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-full mb-6">
        <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold text-zinc-900 dark:text-zinc-100 mb-4">
        Archivo de Posts
      </h1>
      
      <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto mb-8">
        Explora nuestra colección completa de artículos organizados cronológicamente
      </p>
      
      <!-- Statistics -->
      <div class="flex flex-wrap justify-center gap-6 text-sm">
        <div class="bg-white dark:bg-zinc-800 rounded-lg px-4 py-2 border border-zinc-200 dark:border-zinc-700">
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">{totalPosts}</span>
          <span class="text-zinc-600 dark:text-zinc-400 ml-1">artículos totales</span>
        </div>
        <div class="bg-white dark:bg-zinc-800 rounded-lg px-4 py-2 border border-zinc-200 dark:border-zinc-700">
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">{postsThisYear}</span>
          <span class="text-zinc-600 dark:text-zinc-400 ml-1">este año</span>
        </div>
        <div class="bg-white dark:bg-zinc-800 rounded-lg px-4 py-2 border border-zinc-200 dark:border-zinc-700">
          <span class="font-semibold text-zinc-900 dark:text-zinc-100">{years.length}</span>
          <span class="text-zinc-600 dark:text-zinc-400 ml-1">años de contenido</span>
        </div>
      </div>
    </div>

    <!-- Archive Content -->
    <div class="space-y-12">
      {years.map(year => {
        const yearData = postsByDate[year];
        const months = Object.keys(yearData).map(Number).sort((a, b) => b - a);
        const yearPostCount = months.reduce((sum, month) => sum + yearData[month].posts.length, 0);
        
        return (
          <div class="archive-year" data-year={year}>
            <!-- Year Header -->
            <div class="flex items-center justify-between mb-8 pb-4 border-b-2 border-zinc-200 dark:border-zinc-700">
              <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-3">
                <span class="text-blue-600 dark:text-blue-400">{year}</span>
                <span class="text-sm font-normal text-zinc-500 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-3 py-1 rounded-full">
                  {yearPostCount} {yearPostCount === 1 ? 'artículo' : 'artículos'}
                </span>
              </h2>
              
              <button 
                class="year-toggle flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
                data-target={`year-${year}`}
                aria-expanded="true"
              >
                <span class="text-sm">Contraer</span>
                <svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
            </div>
            
            <!-- Months -->
            <div id={`year-${year}`} class="year-content space-y-8">
              {months.map(monthIndex => {
                const monthData = yearData[monthIndex];
                
                return (
                  <div class="archive-month">
                    <!-- Month Header -->
                    <div class="flex items-center justify-between mb-6">
                      <h3 class="text-xl font-semibold text-zinc-800 dark:text-zinc-200 flex items-center gap-2">
                        <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                        {monthData.name}
                        <span class="text-sm font-normal text-zinc-500 dark:text-zinc-400">
                          ({monthData.posts.length})
                        </span>
                      </h3>
                      
                      <button 
                        class="month-toggle text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors"
                        data-target={`month-${year}-${monthIndex}`}
                        aria-expanded="true"
                      >
                        <svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </button>
                    </div>
                    
                    <!-- Posts -->
                    <div id={`month-${year}-${monthIndex}`} class="month-content grid gap-6 md:gap-8">
                      {monthData.posts.map(post => (
                        <article class="group bg-white dark:bg-zinc-800 rounded-xl border border-zinc-200 dark:border-zinc-700 overflow-hidden hover:shadow-lg hover:border-zinc-300 dark:hover:border-zinc-600 transition-all duration-300">
                          <div class="md:flex">
                            {post.data.heroImage && (
                              <div class="md:w-48 md:flex-shrink-0">
                                <div class="h-48 md:h-full relative overflow-hidden">
                                  <ResponsiveImage
                                    src={post.data.heroImage}
                                    alt={post.data.title}
                                    width={300}
                                    height={200}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    loading="lazy"
                                  />
                                </div>
                              </div>
                            )}
                            
                            <div class="p-6 flex-1">
                              <div class="flex items-center gap-3 mb-3">
                                <FormattedDate date={post.data.pubDate} class="text-sm text-zinc-500 dark:text-zinc-400" />
                                {post.data.readingTime && (
                                  <>
                                    <span class="text-zinc-300 dark:text-zinc-600">•</span>
                                    <span class="text-sm text-zinc-500 dark:text-zinc-400">{post.data.readingTime}</span>
                                  </>
                                )}
                              </div>
                              
                              <h4 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                <a href={`/blog/${post.slug}/`} class="stretched-link">
                                  {post.data.title}
                                </a>
                              </h4>
                              
                              {post.data.description && (
                                <p class="text-zinc-600 dark:text-zinc-400 mb-4 line-clamp-2">
                                  {post.data.description}
                                </p>
                              )}
                              
                              {post.data.tags && post.data.tags.length > 0 && (
                                <div class="flex flex-wrap gap-2">
                                  {post.data.tags.slice(0, 3).map(tag => (
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-zinc-100 dark:bg-zinc-700 text-zinc-800 dark:text-zinc-200">
                                      {tag}
                                    </span>
                                  ))}
                                  {post.data.tags.length > 3 && (
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium text-zinc-500 dark:text-zinc-400">
                                      +{post.data.tags.length - 3} más
                                    </span>
                                  )}
                                </div>
                              )}
                            </div>
                          </div>
                        </article>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Back to Top Button -->
    <div class="fixed bottom-8 right-8 z-10">
      <button 
        id="back-to-top"
        class="hidden bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-full shadow-lg transition-all duration-300 hover:scale-110"
        aria-label="Volver arriba"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </button>
    </div>
  </div>
</Layout>

<style>
  .stretched-link::after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    content: "";
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Smooth animations */
  .archive-year {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  .archive-year:nth-child(2) { animation-delay: 0.1s; }
  .archive-year:nth-child(3) { animation-delay: 0.2s; }
  .archive-year:nth-child(4) { animation-delay: 0.3s; }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Collapse/expand transitions */
  .year-content,
  .month-content {
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .year-content.collapsed,
  .month-content.collapsed {
    max-height: 0;
    opacity: 0;
    margin: 0;
    padding: 0;
  }

  /* Hover effects */
  article:hover {
    transform: translateY(-2px);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .archive-year {
      animation-delay: 0s;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Toggle functionality for years and months
    const toggleButtons = document.querySelectorAll('.year-toggle, .month-toggle');
    
    toggleButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-target');
        const target = document.getElementById(targetId);
        const icon = button.querySelector('svg');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        
        if (target && icon) {
          if (isExpanded) {
            target.classList.add('collapsed');
            icon.style.transform = 'rotate(-90deg)';
            button.setAttribute('aria-expanded', 'false');
            if (button.classList.contains('year-toggle')) {
              button.querySelector('span').textContent = 'Expandir';
            }
          } else {
            target.classList.remove('collapsed');
            icon.style.transform = 'rotate(0deg)';
            button.setAttribute('aria-expanded', 'true');
            if (button.classList.contains('year-toggle')) {
              button.querySelector('span').textContent = 'Contraer';
            }
          }
        }
      });
    });

    // Back to top functionality
    const backToTopButton = document.getElementById('back-to-top');
    
    if (backToTopButton) {
      window.addEventListener('scroll', () => {
        if (window.pageYOffset > 300) {
          backToTopButton.classList.remove('hidden');
        } else {
          backToTopButton.classList.add('hidden');
        }
      });

      backToTopButton.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // Close all expanded sections
        const expandedButtons = document.querySelectorAll('[aria-expanded="true"]');
        expandedButtons.forEach(button => {
          button.click();
        });
      }
    });

    // Analytics tracking
    const archiveLinks = document.querySelectorAll('a[href^="/blog/"]');
    archiveLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'archive_post_click', {
            event_category: 'engagement',
            event_label: link.getAttribute('href')
          });
        }
      });
    });
  });
</script>